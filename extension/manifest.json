{
  "manifest_version": 3,
  "name": "Pinnote",
  "version": "0.1.0",
  "description": "Pin notes on elements of your dev sites. Claude Code picks them up from the project folder and answers on the page.",
  "key": "",
  "minimum_chrome_version": "127",
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "nativeMessaging",
    "notifications",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pinnote",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "pick": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Pin a note: click an element or drag an area"
    }
  }
}
